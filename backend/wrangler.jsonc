{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "routesync",
  "main": "src/index.js",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
